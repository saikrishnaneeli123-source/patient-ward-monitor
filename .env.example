# Claude API key used for case-sheet extraction.
# Leave unset to run the app with extraction disabled (manual entry still works).
ANTHROPIC_API_KEY=

# SQLite by default. Point at Postgres etc. for a real deployment.
WARD_DATABASE_URL=sqlite:///./ward.db

# Where uploaded scans are stored.
WARD_UPLOAD_DIR=./uploads

# Model used for extraction.
WARD_EXTRACTION_MODEL=claude-opus-5

# Max upload size in megabytes.
WARD_MAX_UPLOAD_MB=25
